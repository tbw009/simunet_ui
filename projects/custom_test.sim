                "threadsafe": true,
                "params": {
                    "compute_src": {
                        "value": "# Import necessary packages\nimport numpy as np\n\n# Get input var T_s\nT_s = self.get_var(\"T_s\")\n\n# Get time\nt = self.get_t()\n\n# Compute output var c\nc = np.sin(np.array(t) * 0.2)*(np.array(T_s) - 250.0)\n\n# Finally store results\nself.set_var(\"c\", c)",
